<Window x:Class="PP2_Live_Tracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PP2 Live Tracker"
        Width="1200"
        Height="700"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#202124">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Otsikko -->
        <StackPanel Grid.Row="0">

            <TextBlock
        Text=" PP2 Live Tracker"
        FontSize="32"
        FontWeight="Bold"
        Foreground="White"
        Margin="0,0,0,15"/>

            <TextBlock
    x:Name="StatusText"
    Text="🔴 Tila: Ei peliä löytynyt"
    FontSize="18"
    Foreground="White"
    Margin="0,0,0,20"/>

            <Button
    x:Name="StartButton"
    Width="180"
    Height="42"
    HorizontalAlignment="Left"
    Content="Aloita seuranta"
    Click="StartButton_Click"
    Visibility="Collapsed"/>

        </StackPanel>


        <!-- Sisältö -->
        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Vasen paneeli -->
            <Border
                Margin="0,0,10,0"
                CornerRadius="10"
                Background="#2B2B2B"
                Padding="20">

                <StackPanel>
                    <Border
    Margin="0,20,0,20"
    Height="260"
    CornerRadius="8"
    BorderBrush="#555"
    BorderThickness="1">

                        <Image
        x:Name="PreviewImage"
        Stretch="Uniform"/>
                    </Border>

                    <TextBlock
                        Text="Viimeisin kala"
                        FontSize="22"
                        FontWeight="Bold"
                        Foreground="White"/>


                    <TextBlock
    x:Name="FishNameText"
    Margin="0,20,0,0"
    Text="Ei kalaa"
    FontSize="36"
    FontWeight="Bold"
    Foreground="LightGreen"/>

                    <TextBlock
    x:Name="FishWeightText"
    Margin="0,10,0,0"
    Text="0 g"
    FontSize="22"
    Foreground="White"/>

                    <TextBlock
    x:Name="PlayerText"
    Margin="0,10,0,0"
    Text="Pelaaja: -"
    FontSize="18"
    Foreground="LightGray"/>

                    <TextBlock
    x:Name="TimeText"
    Margin="0,5,0,20"
    Text="Aika: -"
    FontSize="18"
    Foreground="LightGray"/>
                    <TextBlock
    Text="Loki"
    FontSize="20"
    FontWeight="Bold"
    Foreground="White"/>

                    <ListBox
    x:Name="LogList"
    Margin="0,10,0,0"
    Background="#1E1E1E"
    Foreground="White"
    BorderThickness="0"
    Height="350"/>


                </StackPanel>

            </Border>

            <!-- Oikea paneeli -->
            <Border
                Grid.Column="1"
                CornerRadius="10"
                Background="#2B2B2B"
                Padding="20">

                <StackPanel>

                    <TextBlock
                        Text="Tilastot"
                        FontSize="22"
                        FontWeight="Bold"
                        Foreground="White"/>

                    <TextBlock
                        Margin="0,25,0,0"
                        Text="Kaloja: 0"
                        FontSize="18"
                        Foreground="White"/>

                    <TextBlock
                        Margin="0,10,0,0"
                        Text="Paino: 0 g"
                        FontSize="18"
                        Foreground="White"/>

                    <TextBlock
                        Margin="0,10,0,0"
                        Text="Suurin kala: -"
                        FontSize="18"
                        Foreground="White"/>


                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</Window>