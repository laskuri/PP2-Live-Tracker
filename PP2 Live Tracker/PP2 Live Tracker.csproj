<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<RootNamespace>PP2_Live_Tracker</RootNamespace>

		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>

		<!-- Julkaistaan 64-bittiselle Windowsille -->
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>

		<!-- Käyttäjän ei tarvitse asentaa .NET Runtimea -->
		<SelfContained>true</SelfContained>

		<!-- Julkaisu yhdeksi EXE-tiedostoksi -->
		<PublishSingleFile>true</PublishSingleFile>

		<!-- Pakataan myös natiivikirjastot EXE:n sisään -->
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

		<!-- Puretaan sisältötiedostot käynnistyessä väliaikaiseen kansioon.
		     Tätä tarvitaan erityisesti Tesseractia ja glyph-kuvia varten. -->
		<IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>

		<!-- Ei erillistä PDB-tiedostoa -->
		<DebugType>embedded</DebugType>
		<DebugSymbols>false</DebugSymbols>

		<!-- Älä ota trimmausta käyttöön:
		     se voi rikkoa WPF:n tai Tesseractin reflection-toimintoja. -->
		<PublishTrimmed>false</PublishTrimmed>

		<!-- Ei ReadyToRunia tässä vaiheessa -->
		<PublishReadyToRun>false</PublishReadyToRun>
	</PropertyGroup>

	<!-- Tesseractin kielitiedostot -->
	<ItemGroup>
		<None Remove="Assets\tessdata\eng.traineddata" />
		<None Remove="Assets\tessdata\fin.traineddata" />

		<Content Include="Assets\tessdata\eng.traineddata">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<ExcludeFromSingleFile>false</ExcludeFromSingleFile>
		</Content>

		<Content Include="Assets\tessdata\fin.traineddata">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<ExcludeFromSingleFile>false</ExcludeFromSingleFile>
		</Content>
	</ItemGroup>

	<!-- Oman glyph-tunnistimen mallikuvat -->
	<ItemGroup>
		<Folder Include="Views\" />
		<Folder Include="ViewModels\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />

		<PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />

		<PackageReference Include="System.Drawing.Common" Version="10.0.10" />

		<PackageReference Include="Tesseract" Version="5.2.0" />

		<PackageReference Include="Tesseract.Drawing" Version="5.2.0" />

		<PackageReference Include="WPF-UI" Version="4.3.0" />
	</ItemGroup>

</Project>